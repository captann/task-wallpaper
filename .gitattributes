# Normalize text files
* text=auto

# Source code and documentation
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts and installer
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary